PORT=5000
NODE_ENV=development

# Database (local or MongoDB Atlas — use a NEW Elite DB, not Elegance)
MONGODB_URI=mongodb://localhost:27017/elite-dental-system
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/elite-dental-system?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_secure_key_in_production
JWT_EXPIRE=7d

# CORS / frontend (Vercel URL after deploy)
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# Socket.io
SOCKET_IO_CORS=http://localhost:4200

# Print agent (same value as print-agent/config.json)
PRINT_AGENT_SECRET=change_me_elite_print_secret

# Logging
LOG_LEVEL=debug

# Demo users (after MongoDB is up): npm run seed — see scripts/seedUsers.js for emails/password.
